<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_process_control" model="ir.module.category">
            <field name="name">Process Control</field>
            <field name="description">Access rights for the process-control platform layer.</field>
            <field name="sequence">31</field>
        </record>

        <record id="privilege_process_control" model="res.groups.privilege">
            <field name="name">Process Control</field>
            <field name="category_id" ref="module_category_process_control"/>
        </record>

        <record id="group_process_user" model="res.groups">
            <field name="name">Process / User</field>
            <field name="privilege_id" ref="privilege_process_control"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view exceptions, DLQ entries, SLA clocks, and idempotency keys for records they own or follow.</field>
        </record>

        <record id="group_process_officer" model="res.groups">
            <field name="name">Process / Officer</field>
            <field name="privilege_id" ref="privilege_process_control"/>
            <field name="implied_ids" eval="[(4, ref('group_process_user'))]"/>
            <field name="comment">Can claim, route, retry, resolve, escalate exceptions and DLQ entries.</field>
        </record>

        <record id="group_process_admin" model="res.groups">
            <field name="name">Process / Admin</field>
            <field name="privilege_id" ref="privilege_process_control"/>
            <field name="implied_ids" eval="[(4, ref('group_process_officer'))]"/>
            <field name="comment">Full process-control admin. Subject to audit-log review.</field>
        </record>
    </data>
</odoo>
