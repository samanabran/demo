<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_process_exception_search" model="ir.ui.view">
        <field name="name">process.exception.search</field>
        <field name="model">process.exception</field>
        <field name="arch" type="xml">
            <search string="Process Exceptions">
                <field name="summary"/>
                <field name="classification"/>
                <field name="target_system"/>
                <field name="integration_key"/>
                <field name="owner_id"/>
                <separator/>
                <filter name="filter_open" string="Open" domain="[('status','=','open')]"/>
                <filter name="filter_in_progress" string="In progress" domain="[('status','=','in_progress')]"/>
                <filter name="filter_escalated" string="Escalated" domain="[('status','=','escalated')]"/>
                <filter name="filter_dlq" string="Dead-letter" domain="[('status','=','dead_letter')]"/>
                <filter name="filter_critical" string="Critical" domain="[('severity','=','critical')]"/>
                <separator/>
                <filter name="filter_alerting" string="Alerting" domain="[('alert','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_classification" string="Classification" context="{'group_by':'classification'}"/>
                    <filter name="group_by_severity" string="Severity" context="{'group_by':'severity'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by':'status'}"/>
                    <filter name="group_by_target" string="Target system" context="{'group_by':'target_system'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_process_exception_tree" model="ir.ui.view">
        <field name="name">process.exception.list</field>
        <field name="model">process.exception</field>
        <field name="arch" type="xml">
            <list string="Exceptions"
                  decoration-danger="severity=='critical' and status not in ('resolved','sealed','dead_letter')"
                  decoration-warning="severity in ('error','warning') and status not in ('resolved','sealed','dead_letter')"
                  decoration-muted="status in ('resolved','sealed','dead_letter')">
                <field name="occurred_at"/>
                <field name="summary"/>
                <field name="classification" widget="badge"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity=='critical'"
                       decoration-warning="severity in ('error','warning')"
                       decoration-info="severity=='info'"/>
                <field name="status" widget="badge"
                       decoration-danger="status in ('escalated','dead_letter')"
                       decoration-warning="status=='in_progress'"
                       decoration-success="status in ('resolved','sealed')"/>
                <field name="target_system" optional="show"/>
                <field name="integration_key" optional="hide"/>
                <field name="owner_id" optional="show" widget="many2one_avatar_user"/>
                <field name="retry_count"/>
                <field name="age_hours"/>
                <field name="alert" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_process_exception_form" model="ir.ui.view">
        <field name="name">process.exception.form</field>
        <field name="model">process.exception</field>
        <field name="arch" type="xml">
            <form string="Process Exception">
                <header>
                    <button name="action_mark_in_progress" string="Take"
                            type="object" class="btn-primary"
                            invisible="status != 'open'"
                            groups="sgc_process_control.group_process_officer"/>
                    <button name="action_escalate" string="Escalate"
                            type="object" class="btn-warning"
                            invisible="status in ('escalated','resolved','sealed','dead_letter')"
                            groups="sgc_process_control.group_process_officer"/>
                    <button name="action_resolve" string="Resolve"
                            type="object" class="btn-success"
                            invisible="status in ('resolved','sealed','dead_letter')"
                            groups="sgc_process_control.group_process_officer"/>
                    <button name="action_seal" string="Seal"
                            type="object"
                            invisible="status not in ('resolved','escalated')"
                            groups="sgc_process_control.group_process_admin"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="open,in_progress,escalated,resolved,sealed"/>
                </header>
                <sheet>
                    <group>
                        <group name="classification" string="Classification">
                            <field name="classification" widget="radio"/>
                            <field name="severity" widget="radio"/>
                            <field name="alert" widget="boolean_toggle"/>
                            <field name="alert_message" invisible="not alert"/>
                        </group>
                        <group name="source" string="Source">
                            <field name="source_model"/>
                            <field name="source_id"/>
                            <field name="target_system"/>
                            <field name="integration_key"/>
                            <field name="reference"/>
                        </group>
                        <group name="ownership" string="Ownership">
                            <field name="owner_id"/>
                            <field name="team_id"/>
                            <field name="escalation_level"/>
                        </group>
                        <group name="timing" string="Timing">
                            <field name="occurred_at"/>
                            <field name="detected_at"/>
                            <field name="resolved_at"/>
                            <field name="age_hours"/>
                            <field name="retention_until"/>
                        </group>
                        <group name="retry" string="Retry">
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                            <field name="next_retry_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="summary" string="Summary">
                            <field name="summary" placeholder="What went wrong, in one line."/>
                            <field name="description" placeholder="What the consumer was trying to do, what it got back, what the next action is."/>
                        </page>
                        <page name="chatter" string="Chatter">
                            <chatter/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_process_exception" model="ir.actions.act_window">
        <field name="name">Process Exceptions</field>
        <field name="res_model">process.exception</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_process_exception_search"/>
        <field name="context">{'search_default_filter_open': 1, 'search_default_group_by_severity': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No exceptions yet.
            </p>
            <p>
                Every module writes here when something fails. Open the queue
                regularly and route by classification.
            </p>
        </field>
    </record>
</odoo>
