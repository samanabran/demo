<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Odoo 19: res.groups has no 'category_id'; groups are organized via
             res.groups.privilege (which itself links to ir.module.category). -->
        <record id="module_crm_dashboard" model="ir.module.category">
            <field name="name">CRM Executive Dashboard</field>
            <field name="description">Access rights for the CRM Executive Dashboard</field>
            <field name="sequence">60</field>
        </record>

        <record id="privilege_crm_dashboard" model="res.groups.privilege">
            <field name="name">CRM Dashboard</field>
            <field name="category_id" ref="module_crm_dashboard"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_crm_dashboard_user" model="res.groups">
            <field name="name">CRM Dashboard User</field>
            <field name="privilege_id" ref="privilege_crm_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">View-only access to the CRM Executive Dashboard</field>
        </record>

        <record id="group_crm_dashboard_manager" model="res.groups">
            <field name="name">CRM Dashboard Manager</field>
            <field name="privilege_id" ref="privilege_crm_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('group_crm_dashboard_user'))]"/>
            <field name="comment">Can configure filters, alerts, and exports</field>
        </record>

        <record id="group_crm_dashboard_executive" model="res.groups">
            <field name="name">CRM Dashboard Executive</field>
            <field name="privilege_id" ref="privilege_crm_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('group_crm_dashboard_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Full executive access including scheduled reports and BI exports</field>
        </record>
    </data>
</odoo>
