// ─────────────────────────────────────────────────────────────────────
// SGC Dynamic Financial Reports – Frontend Styles
// ─────────────────────────────────────────────────────────────────────
// These styles are loaded in web.assets_frontend.
// ─────────────────────────────────────────────────────────────────────

// ── Report Container ────────────────────────────────────────────────
.o_sgc_report_container {
    margin: 0 -16px;
    padding: 0 16px;

    .sgc-report {
        font-size: 13px;
        line-height: 1.5;
    }
}

// ── Report Table ─────────────────────────────────────────────────────
.o_sgc_report_table {
    border-collapse: collapse;
    width: 100%;
    margin-bottom: 1rem;
    color: #212529;

    th,
    td {
        padding: 0.5rem 0.75rem;
        border: 1px solid #dee2e6;
        text-align: right;
        white-space: nowrap;
    }

    th {
        background-color: #007bff;
        color: #ffffff;
        font-weight: 600;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    td:first-child,
    th:first-child {
        text-align: left;
    }

    // Section header rows (group by account type, partner, etc.)
    tr.section-header td {
        background-color: #e9ecef;
        font-weight: 700;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    // Total / subtotal rows
    tr.total-row td {
        background-color: #d1ecf1;
        font-weight: 700;
        border-top: 2px solid #0c5460;
    }

    // Grand total row
    tr.grand-total td {
        background-color: #cce5ff;
        font-weight: 700;
        border-top: 3px double #004085;
        font-size: 14px;
    }

    // Negative amounts
    .negative {
        color: #dc3545;
    }

    // Positive amounts
    .positive {
        color: #28a745;
    }

    // Zero balance rows (when not hidden)
    tr.zero-balance {
        color: #6c757d;
        font-style: italic;
    }

    // Hover effect
    tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }

    // Indentation for hierarchy
    td.indent-1 { padding-left: 1.5rem; }
    td.indent-2 { padding-left: 2.5rem; }
    td.indent-3 { padding-left: 3.5rem; }
    td.indent-4 { padding-left: 4.5rem; }
}

// ── Analytic Breakdown Columns ───────────────────────────────────
// Engine emits a "Analytic Breakdown" colspan header row + per-line
// analytic amount cells with the .analytic-cell class.
.analytic-cell {
    background-color: rgba(13, 110, 253, 0.06);
    font-style: italic;
    color: #0d6efd;
}

tfoot .analytic-total {
    background-color: rgba(13, 110, 253, 0.04);
    border-top: 1px dotted #0d6efd;
}

.analytic-breakdown-badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    margin-left: 0.5rem;
    border-radius: 4px;
    background-color: #cff4fc;
    color: #055160;
    font-size: 11px;
    font-weight: 600;
}

// ── Multi-Company / Currency Hint ────────────────────────────────
// Used by the wizard to surface the multi-company + currency hint
// when the consolidate_companies checkbox is on.
.o_sgc_multi_company_hint {
    margin-top: 0.25rem;
    padding: 0.35rem 0.6rem;
    background-color: #fff3cd;
    border-left: 3px solid #ffc107;
    border-radius: 0 4px 4px 0;
    font-size: 12px;
    color: #664d03;
}

// ── Schedule Block ───────────────────────────────────────────────
// Status indicators on the wizard's Schedule section.
.o_sgc_schedule_status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background-color: #e2f3fc;
    border-radius: 4px;
    font-size: 12px;
    color: #055160;

    &.scheduled {
        background-color: #d1e7dd;
        color: #0f5132;
    }
}

.o_sgc_field_schedule_cron_id {
    opacity: 0.7;
    pointer-events: none;
}

// ── Budget vs Actual / Analytic Breakdown indicator badges ───────
// Shown next to the report title in the result view when these flags
// were used during generation.
.o_sgc_flag_pills {
    display: inline-flex;
    gap: 0.25rem;
    margin-top: 0.25rem;

    .o_sgc_flag_pill {
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        background-color: #e7f1ff;
        color: #084298;
        font-size: 11px;
        font-weight: 600;
    }
}

// ── Report Header / Footer ──────────────────────────────────────────
.sgc_report_header {
    text-align: center;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #007bff;

    h2 {
        font-size: 18px;
        margin-bottom: 0.25rem;
        color: #212529;
    }

    h3 {
        font-size: 15px;
        margin-bottom: 0.25rem;
        color: #495057;
    }

    p {
        font-size: 12px;
        color: #6c757d;
        margin-bottom: 0;
    }
}

.sgc_report_footer {
    margin-top: 2rem;
    padding-top: 0.75rem;
    border-top: 1px solid #dee2e6;
    text-align: center;
    font-size: 10px;
    color: #6c757d;
}

// ── Loading State ───────────────────────────────────────────────────
.sgc-financial-report-widget {
    &.o_loading {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 200px;
    }
}

.sgc_report_loading {
    text-align: center;
    padding: 3rem;
}

// ── Report Toolbar ──────────────────────────────────────────────────
.sgc_report_toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.5rem 0;

    .sgc_report_title {
        margin-left: auto;
        font-weight: 600;
        font-size: 14px;
        color: #495057;
    }
}

// ── Collapsible Report Sections ─────────────────────────────────────
// Native <details>/<summary> — no JS/OWL involved. Collapsed by default;
// the "Expand All / Collapse All" bar operates on these via plain
// onclick handlers built in _build_collapse_toggle_bar().
.sgc_collapse_toggle_bar {
    margin: 0.5rem 0;
    display: flex;
    gap: 0.5rem;
}

.sgc_collapsible_section {
    margin-bottom: 0.75rem;

    > summary.sgc_section_title {
        cursor: pointer;
        font-weight: 600;
        font-size: 1rem;
        padding: 0.35rem 0;
        list-style-position: outside;

        &:hover {
            color: #007bff;
        }
    }

    // First table right after the summary shouldn't add extra top gap.
    > summary.sgc_section_title + * {
        margin-top: 0.25rem;
    }
}

// ── Print Styles ────────────────────────────────────────────────────
@media print {
    .sgc_report_toolbar {
        display: none !important;
    }

    .sgc_collapse_toggle_bar {
        display: none !important;
    }

    // Force every collapsible section fully visible on print/PDF export
    // regardless of its on-screen open/closed state — printing can't
    // "click", so collapse state must never affect exported output.
    // (Defense-in-depth: the PDF path already generates every ``<details>``
    // pre-``open`` in Python via ``sgc_dfr_for_print`` - see
    // ``_wrap_collapsible`` - because not every wkhtmltopdf build honors
    // ``@media print`` consistently. This CSS is a second line of defense,
    // and also removes the on-screen disclosure marker.)
    .sgc_collapsible_section {
        > summary::-webkit-details-marker {
            display: none;
        }

        > summary::marker {
            content: "";
        }
    }

    .sgc_collapsible_section:not([open]) > *:not(summary) {
        display: block !important;
    }

    .o_sgc_report_table {
        th {
            background-color: #ddd !important;
            color: #000 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }

    .sgc_report_header h2,
    .sgc_report_header h3 {
        color: #000 !important;
    }
}

// ── PDF Document (print-only report layout) ─────────────────────────
// Scoped to the QWeb PDF template's `.sgc_pdf_document` wrapper only -
// does not affect the on-screen enterprise preview, which keeps its own
// look. Uses SGC brand colors (navy #0F2C4C / gold #C9A227) instead of
// the generic Bootstrap blue used for the on-screen preview, and drops
// interaction-only affordances (hover states, sticky headers, collapse
// toggle bar) that have no meaning in a static, printed document.
.sgc_pdf_document {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: #1a1a1a;

    .sgc_report_header {
        border-bottom-color: #0f2c4c;

        h2 {
            color: #0f2c4c;
            font-size: 20px;
            font-weight: 700;
        }

        h3 {
            color: #0f2c4c;
            font-size: 15px;
            font-weight: 500;
        }

        p {
            color: #55606b;
        }
    }

    .sgc_section_title {
        color: #0f2c4c;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #c9a227;
        padding-bottom: 0.2rem;
        margin-bottom: 0.4rem;
        list-style: none;

        &::-webkit-details-marker {
            display: none;
        }

        &::marker {
            content: "";
        }
    }

    // Print rendering uses plain <div><h4> section blocks instead of
    // <details> (see _wrap_collapsible's `sgc_dfr_for_print` branch) -
    // wkhtmltopdf's bundled WebKit does not reliably render <details>
    // content. Same spacing as the on-screen collapsible sections.
    .sgc_section_block {
        margin-bottom: 0.75rem;
    }

    .o_sgc_report_table {
        font-size: 11px;
        margin-bottom: 1rem;

        th {
            background-color: #0f2c4c !important;
            color: #ffffff !important;
            font-size: 10px;
            position: static; // sticky header is meaningless on a static page
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        td,
        th {
            padding: 0.35rem 0.6rem;
        }

        tbody tr:hover {
            background-color: transparent; // no hover state on a printed page
        }

        tr.total-row td {
            background-color: #f2ede0 !important;
            border-top: 1.5px solid #0f2c4c;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        // Avoid a row's content splitting across a page boundary.
        tr {
            page-break-inside: avoid;
        }
    }

    .o_sgc_grand_total_table {
        margin-top: 0.5rem;

        tr.grand-total td {
            background-color: #0f2c4c !important;
            color: #ffffff !important;
            border-top: 2px solid #c9a227;
            font-size: 13px;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }

    .sgc_report_footer {
        color: #8a949e;
    }
}