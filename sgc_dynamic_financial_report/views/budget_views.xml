<odoo>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- SEARCH VIEW – sgc.dfr.budget                                      -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <record id="sgc_dfr_budget_view_search" model="ir.ui.view">
        <field name="name">sgc.dfr.budget.view.search</field>
        <field name="model">sgc.dfr.budget</field>
        <field name="arch" type="xml">
            <search string="Search Budgets">
                <field name="account_id"/>
                <field name="company_id"/>
                <field name="fiscal_year"/>
                <separator/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="group_company"
                            context="{'group_by': 'company_id'}"/>
                    <filter string="Fiscal Year" name="group_fiscal_year"
                            context="{'group_by': 'fiscal_year'}"/>
                    <filter string="Account" name="group_account"
                            context="{'group_by': 'account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- LIST VIEW – sgc.dfr.budget                                        -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <record id="sgc_dfr_budget_view_list" model="ir.ui.view">
        <field name="name">sgc.dfr.budget.view.list</field>
        <field name="model">sgc.dfr.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets" decoration-danger="not active" decoration-muted="not active">
                <field name="account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="fiscal_year"/>
                <field name="amount"/>
                <field name="currency_id" invisible="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- FORM VIEW – sgc.dfr.budget                                        -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <record id="sgc_dfr_budget_view_form" model="ir.ui.view">
        <field name="name">sgc.dfr.budget.view.form</field>
        <field name="model">sgc.dfr.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <sheet>
                    <div class="oe_title">
                        <label for="account_id" class="oe_edit_only"/>
                        <h1>
                            <field name="account_id" placeholder="Account"/>
                        </h1>
                    </div>
                    <group>
                        <group name="header" string="Budget Header">
                            <field name="account_id"
                                   options="{'no_create': True}"/>
                            <field name="company_id"
                                   options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                            <field name="fiscal_year"/>
                            <field name="amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group name="status" string="Status">
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="budget_lines" string="Budget Lines">
                            <field name="line_ids" nolabel="1">
                                <list string="Monthly Budgets" editable="bottom">
                                    <field name="period"/>
                                    <field name="amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="analytic_account_id"
                                           options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- TREE VIEW – sgc.dfr.budget.line (embedded in budget form)         -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <record id="sgc_dfr_budget_line_view_tree" model="ir.ui.view">
        <field name="name">sgc.dfr.budget.line.view.tree</field>
        <field name="model">sgc.dfr.budget.line</field>
        <field name="arch" type="xml">
            <list string="Budget Lines">
                <field name="budget_id" invisible="1"/>
                <field name="period"/>
                <field name="amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="analytic_account_id" optional="show"
                       options="{'no_create': True}"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- ACTION – Budgets                                                   -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <record id="sgc_dfr_action_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">sgc.dfr.budget</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sgc_dfr_budget_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No budgets defined yet
            </p>
            <p>
                Budgets let you compare actual financial performance
                against planned targets. Each budget is linked to an
                account, company, and fiscal year, with per-period
                breakdowns.
            </p>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- MENUITEM – Budgets                                                 -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <menuitem
        id="sgc_dfr_menu_budgets"
        name="Budgets"
        parent="sgc_dynamic_financial_report.sgc_dfr_menu_root"
        action="sgc_dfr_action_budget"
        sequence="120"
        groups="sgc_dynamic_financial_report.sgc_dfr_group_manager"/>

</odoo>
