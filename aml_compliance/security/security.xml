<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company rule: users only see assessments for their company -->
        <record id="rule_risk_assessment_company" model="ir.rule">
            <field name="name">Risk Assessment: Multi-Company</field>
            <field name="model_id" ref="model_aml_risk_assessment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_aml_officer'))]"/>
        </record>

        <!-- goAML Report multi-company -->
        <record id="rule_goaml_report_company" model="ir.rule">
