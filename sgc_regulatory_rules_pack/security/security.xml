<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- Groups                                                      -->
        <!-- ============================================================ -->

        <record id="module_category_regulatory" model="ir.module.category">
            <field name="name">Regulatory Rules Pack</field>
            <field name="description">Access rights for the regulatory rules pack.</field>
            <field name="sequence">30</field>
        </record>

        <record id="privilege_regulatory" model="res.groups.privilege">
            <field name="name">Regulatory Rules Pack</field>
            <field name="category_id" ref="module_category_regulatory"/>
        </record>

        <record id="group_compliance" model="res.groups">
            <field name="name">Regulatory Editor / Read-write</field>
            <field name="privilege_id" ref="privilege_regulatory"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Tenant-side users who configure the rules pack on behalf of their organisation. Can read all constants and propose new values. Cannot delete.</field>
        </record>

        <record id="group_regulatory_admin" model="res.groups">
            <field name="name">Regulatory Admin</field>
            <field name="privilege_id" ref="privilege_regulatory"/>
            <field name="implied_ids" eval="[(4, ref('group_compliance'))]"/>
            <field name="comment">Owns the rules pack. Full CRUD including delete and jurisdiction management. Subject to audit-log review.</field>
        </record>

    </data>
</odoo>
