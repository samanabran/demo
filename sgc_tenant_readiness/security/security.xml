<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_tenant_readiness" model="ir.module.category">
            <field name="name">Tenant Readiness</field>
            <field name="description">Access rights for the tenant-readiness onboarding model.</field>
            <field name="sequence">32</field>
        </record>

        <record id="privilege_tenant_readiness" model="res.groups.privilege">
            <field name="name">Tenant Readiness</field>
            <field name="category_id" ref="module_category_tenant_readiness"/>
        </record>

        <record id="group_tenant_readiness_user" model="res.groups">
            <field name="name">Tenant Readiness / User</field>
            <field name="privilege_id" ref="privilege_tenant_readiness"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view the readiness dashboard and the per-capability state for the user's tenant. Cannot modify.</field>
        </record>

        <record id="group_tenant_readiness_officer" model="res.groups">
            <field name="name">Tenant Readiness / Officer</field>
            <field name="privilege_id" ref="privilege_tenant_readiness"/>
            <field name="implied_ids" eval="[(4, ref('group_tenant_readiness_user'))]"/>
            <field name="comment">Tenant-side administrators who configure the readiness gate, populate TENANT_CONFIG fields, and acknowledge TENANT_DECISION fields. Can record CO/MLRO and Alternate appointments.</field>
        </record>

        <record id="group_tenant_readiness_admin" model="res.groups">
            <field name="name">Tenant Readiness / Admin</field>
            <field name="privilege_id" ref="privilege_tenant_readiness"/>
            <field name="implied_ids" eval="[(4, ref('group_tenant_readiness_officer'))]"/>
            <field name="comment">Full admin. Can record high-risk overrides, sign acknowledgements on behalf of senior management, and unblock capabilities.</field>
        </record>
    </data>
</odoo>
