<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <template id="services_page" name="Services">
      <t t-call="website.layout">
        <t t-set="pageName" t-value="'services'"/>
        <div id="wrap" class="oe_structure oe_empty">

          <!-- Hero -->
          <section class="py-5" style="background: var(--re-bg-page-2, #06101D);">
            <div class="container py-5 text-center">
              <p class="text-uppercase small mb-3"
                 style="letter-spacing: 0.15em; color: var(--re-accent);">Services</p>
              <h1 class="mb-4" style="max-width: 820px; margin-left:auto; margin-right:auto;">
                Everything a property needs, in one platform
              </h1>
              <p class="lead mx-auto" style="max-width: 640px; color: var(--re-text-page-muted);">
                Sales, leasing, ownership, and upkeep — handled end to end, whether
                you're buying your first unit or managing a portfolio of them.
              </p>
            </div>
          </section>

          <!-- Service grid -->
          <section class="container py-5">
            <div class="row g-4">

              <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa fa-building re-icon-badge re-icon-badge-lg mb-3" aria-hidden="true"></i>
                    <h3 class="mb-2">Off-Plan Sales</h3>
                    <p class="mb-0" style="color: var(--re-text-muted);">
                      Browse verified off-plan units by project, developer, and handover
                      date, with full specifications, floor plans, and pricing up front.
                    </p>
                  </div>
                </div>
              </div>

              <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa fa-key re-icon-badge re-icon-badge-lg mb-3" aria-hidden="true"></i>
                    <h3 class="mb-2">Rental &amp; Lease Management</h3>
                    <p class="mb-0" style="color: var(--re-text-muted);">
                      Lease contracts, renewals, and rent schedules tracked in one
                      place, for tenants and landlords alike.
                    </p>
                  </div>
                </div>
              </div>

              <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa fa-user-circle re-icon-badge re-icon-badge-lg mb-3" aria-hidden="true"></i>
                    <h3 class="mb-2">Owner &amp; Tenant Portal</h3>
                    <p class="mb-0" style="color: var(--re-text-muted);">
                      A dedicated account for every relationship — owners see their
                      portfolio, tenants see their lease, landlords see their invoices.
                    </p>
                  </div>
                </div>
              </div>

              <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa fa-wrench re-icon-badge re-icon-badge-lg mb-3" aria-hidden="true"></i>
                    <h3 class="mb-2">Property Management &amp; Maintenance</h3>
                    <p class="mb-0" style="color: var(--re-text-muted);">
                      Maintenance requests get logged, assigned, and closed out with a
                      visible status — not lost in an inbox.
                    </p>
                  </div>
                </div>
              </div>

              <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa fa-file-pdf-o re-icon-badge re-icon-badge-lg mb-3" aria-hidden="true"></i>
                    <h3 class="mb-2">Brochures &amp; Enquiries</h3>
                    <p class="mb-0" style="color: var(--re-text-muted);">
                      Every listing includes a downloadable brochure and a direct line
                      to our team — no waiting on a callback to get the basics.
                    </p>
                  </div>
                </div>
              </div>

              <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa fa-line-chart re-icon-badge re-icon-badge-lg mb-3" aria-hidden="true"></i>
                    <h3 class="mb-2">Financial Reporting</h3>
                    <p class="mb-0" style="color: var(--re-text-muted);">
                      Owners with more than one unit get consolidated statements
                      instead of piecing invoices together by hand.
                    </p>
                  </div>
                </div>
              </div>

            </div>
          </section>

          <!-- CTA -->
          <section class="py-5" style="background: var(--re-bg-page-2, #06101D);">
            <div class="container text-center py-3">
              <h2 class="mb-3">Not sure where to start?</h2>
              <p class="mb-4" style="color: var(--re-text-page-muted);">
                Tell us what you're looking for and we'll point you to the right service.
              </p>
              <a href="/contactus" class="btn btn-primary">Contact Us</a>
            </div>
          </section>

        </div>
      </t>
    </template>

    <record id="website_page_services" model="website.page">
      <field name="view_id" ref="services_page"/>
      <field name="url">/services</field>
      <field name="is_published">True</field>
      <field name="website_indexed">True</field>
    </record>
  </data>
</odoo>
