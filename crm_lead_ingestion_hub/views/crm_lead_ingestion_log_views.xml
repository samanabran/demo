<odoo>
    <record id="view_crm_lead_ingestion_log_list" model="ir.ui.view">
        <field name="name">crm.lead.ingestion.log.list</field>
        <field name="model">crm.lead.ingestion.log</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'success'"
                  decoration-danger="status in ('failed', 'rejected')"
                  decoration-muted="status == 'duplicate'">
                <field name="create_date"/>
                <field name="source_config_id"/>
                <field name="provider"/>
                <field name="status"/>
                <field name="retry_count"/>
                <field name="lead_id"/>
            </list>
        </field>
    </record>

    <record id="view_crm_lead_ingestion_log_form" model="ir.ui.view">
        <field name="name">crm.lead.ingestion.log.form</field>
        <field name="model">crm.lead.ingestion.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="source_config_id"/>
                        <field name="provider"/>
                        <field name="status"/>
                        <field name="lead_id"/>
                        <field name="dedup_key"/>
                        <field name="retry_count"/>
                        <field name="last_attempt"/>
                    </group>
                    <group string="Error" invisible="status not in ('failed', 'rejected')">
                        <field name="error_message"/>
                    </group>
                    <notebook>
                        <page string="Parsed Payload">
                            <field name="parsed_payload" widget="text"/>
                        </page>
                        <page string="Raw Payload">
                            <field name="raw_payload" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_lead_ingestion_log_kanban" model="ir.ui.view">
        <field name="name">crm.lead.ingestion.log.kanban</field>
        <field name="model">crm.lead.ingestion.log</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status">
                <templates>
                    <t t-name="card">
                        <div>
                            <strong><field name="provider"/></strong>
                            <div><field name="create_date"/></div>
                            <div><field name="status"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_crm_lead_ingestion_log" model="ir.actions.act_window">
        <field name="name">Ingestion Logs</field>
        <field name="res_model">crm.lead.ingestion.log</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
