<odoo>
    <record id="ir_cron_retry_failed_ingestion" model="ir.cron">
        <field name="name">CRM Lead Ingestion: Retry Failed</field>
        <field name="model_id" ref="model_crm_lead_ingestion_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_failed()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_purge_old_ingestion_logs" model="ir.cron">
        <field name="name">CRM Lead Ingestion: Purge Old Logs</field>
        <field name="model_id" ref="model_crm_lead_ingestion_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_old_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
