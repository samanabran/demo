<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgc_ces_gate_assignment_list" model="ir.ui.view">
        <field name="name">sgc.ces.gate.assignment.list</field>
        <field name="model">sgc.ces.gate.assignment</field>
        <field name="arch" type="xml">
            <list string="Assignments" decoration-muted="state == 'closed'">
                <field name="employee_id"/>
                <field name="user_id"/>
                <field name="plan_id"/>
                <field name="state" widget="badge"/>
                <field name="start_date"/>
                <field name="ces_start_date"/>
                <field name="manager_user_id"/>
                <field name="instance_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_ces_gate_assignment_form" model="ir.ui.view">
        <field name="name">sgc.ces.gate.assignment.form</field>
        <field name="model">sgc.ces.gate.assignment</field>
        <field name="arch" type="xml">
            <form string="Assignment">
                <header>
                    <button name="action_create_baseline_assessment" type="object"
                            string="Create Baseline Assessment" class="btn-primary"
                            invisible="state != 'pending_baseline' or baseline_assessment_count"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state in ('active', 'pending_baseline')"/>
                    <button name="generate_instances" type="object" string="Generate Gates"
                            invisible="state != 'active'"/>
                    <button name="action_suspend" type="object" string="Suspend"
                            invisible="state != 'active'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state in ('closed','draft','pending_baseline')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state in ('draft', 'pending_baseline')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending_baseline,draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_instances" type="object" class="oe_stat_button"
                                icon="fa-flag-checkered">
                            <field name="instance_count" widget="statinfo" string="Gates"/>
                        </button>
                        <button name="action_view_baseline_assessments" type="object"
                                class="oe_stat_button" icon="fa-user-md"
                                invisible="not baseline_assessment_count">
                            <field name="baseline_assessment_count" widget="statinfo" string="Baseline"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="user_id" readonly="1"/>
                            <field name="plan_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="ces_start_date"/>
                            <field name="manager_user_id"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        Nothing is measured while this assignment is in draft.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sgc_ces_gate_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">sgc.ces.gate.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
