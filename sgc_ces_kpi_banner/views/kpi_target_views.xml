<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgc_ces_kpi_target_list" model="ir.ui.view">
        <field name="name">sgc.ces.kpi.target.list</field>
        <field name="model">sgc.ces.kpi.target</field>
        <field name="arch" type="xml">
            <list string="KPI Targets" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="period"/>
                <field name="metric_code"/>
                <field name="comparator"/>
                <field name="target_value"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_ces_kpi_target_form" model="ir.ui.view">
        <field name="name">sgc.ces.kpi.target.form</field>
        <field name="model">sgc.ces.kpi.target</field>
        <field name="arch" type="xml">
            <form string="KPI Target">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Opportunities touched today"/></h1>
                    </div>
                    <group>
                        <group string="Measurement">
                            <field name="period"/>
                            <field name="metric_code"/>
                            <field name="comparator"/>
                            <field name="target_value"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Applies to">
                            <field name="job_id"/>
                            <field name="department_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Metric options">
                        <field name="proposal_only"/>
                        <field name="min_expected_revenue"/>
                        <field name="staleness_field"/>
                        <field name="stale_days"/>
                        <field name="warn_days"/>
                        <field name="signature_strategy"/>
                        <field name="qualifying_payment_mode"/>
                        <field name="require_opportunity"/>
                    </group>
                    <field name="help_text" placeholder="Shown in the banner tooltip"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sgc_ces_kpi_target" model="ir.actions.act_window">
        <field name="name">KPI Targets</field>
        <field name="res_model">sgc.ces.kpi.target</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a daily or monthly KPI target</p>
            <p>No target values ship with this module. Until you create targets here, the
               banner shows measured values without any target judgement.</p>
        </field>
    </record>
</odoo>
