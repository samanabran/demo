<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgc_ces_gate_instance_list" model="ir.ui.view">
        <field name="name">sgc.ces.gate.instance.list</field>
        <field name="model">sgc.ces.gate.instance</field>
        <field name="arch" type="xml">
            <list string="Gates" decoration-danger="health == 'off_track'"
                  decoration-warning="health == 'at_risk'"
                  decoration-success="state == 'passed'">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="period_start"/>
                <field name="due_date"/>
                <field name="days_remaining"/>
                <field name="score" widget="percentage" string="Score"/>
                <field name="mandatory_met"/>
                <field name="health"/>
                <field name="state" widget="badge"/>
                <field name="manager_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_ces_gate_instance_form" model="ir.ui.view">
        <field name="name">sgc.ces.gate.instance.form</field>
        <field name="model">sgc.ces.gate.instance</field>
        <field name="arch" type="xml">
            <form string="Gate">
                <header>
                    <button name="action_evaluate" type="object" string="Re-measure"/>
                    <button name="action_open_review" type="object" string="Open Review"
                            class="btn-primary"/>
                    <button name="%(action_sgc_ces_consideration_wizard)d" type="action"
                            string="Adjust Target"
                            context="{'default_instance_id': id}"/>
                    <button name="%(action_sgc_ces_extension_wizard)d" type="action"
                            string="Grant Extension"
                            context="{'default_instance_id': id}"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('passed','failed','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,pending_review,in_review,passed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Who">
                            <field name="employee_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="manager_user_id" readonly="1"/>
                            <field name="plan_id" readonly="1"/>
                            <field name="template_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Schedule (snapshotted)">
                            <field name="anchor_date"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="due_date"/>
                            <field name="review_date"/>
                            <field name="days_remaining"/>
                        </group>
                    </group>
                    <group string="Outcome">
                        <field name="score" widget="percentage"/>
                        <field name="pass_threshold"/>
                        <field name="mandatory_met"/>
                        <field name="projected_outcome"/>
                        <field name="health"/>
                    </group>
                    <notebook>
                        <page string="Requirements">
                            <field name="result_ids" readonly="1">
                                <list decoration-success="achieved" decoration-danger="not achieved and level == 'mandatory'">
                                    <field name="name"/>
                                    <field name="metric_code"/>
                                    <field name="comparator"/>
                                    <field name="original_target"/>
                                    <field name="effective_target"/>
                                    <field name="measured_value"/>
                                    <field name="progress" widget="percentage"/>
                                    <field name="level"/>
                                    <field name="achieved"/>
                                    <field name="measured_on"/>
                                    <field name="measurement_error"/>
                                    <button name="action_open_drilldown" type="object"
                                            string="Open" icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reviews">
                            <field name="review_ids" readonly="1">
                                <list>
                                    <field name="alert_type"/>
                                    <field name="alert_scheduled_date"/>
                                    <field name="reviewer_user_id"/>
                                    <field name="state"/>
                                    <field name="decision"/>
                                </list>
                            </field>
                        </page>
                        <page string="Considerations">
                            <field name="consideration_ids" readonly="1">
                                <list>
                                    <field name="consideration_type"/>
                                    <field name="state"/>
                                    <field name="new_due_date"/>
                                    <field name="adjusted_target"/>
                                    <field name="reason"/>
                                    <field name="approved_by_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sgc_ces_gate_instance_search" model="ir.ui.view">
        <field name="name">sgc.ces.gate.instance.search</field>
        <field name="model">sgc.ces.gate.instance</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="name"/>
                <filter name="my_gates" string="My gates"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="to_review" string="To review"
                        domain="[('manager_user_id', '=', uid), ('state', 'in', ['pending_review','in_review'])]"/>
                <filter name="open" string="Open"
                        domain="[('state', 'in', ['active','pending_review','in_review','extended'])]"/>
                <separator/>
                <filter name="overdue" string="Overdue"
                        domain="[('due_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ['passed','failed','cancelled'])]"/>
                <separator/>
                <filter name="group_employee" string="Specialist" context="{'group_by': 'employee_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_sgc_ces_gate_instance" model="ir.actions.act_window">
        <field name="name">Gates</field>
        <field name="res_model">sgc.ces.gate.instance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="action_sgc_ces_my_gates" model="ir.actions.act_window">
        <field name="name">My Gates</field>
        <field name="res_model">sgc.ces.gate.instance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_gates': 1}</field>
    </record>
</odoo>
