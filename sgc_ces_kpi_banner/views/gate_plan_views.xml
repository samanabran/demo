<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgc_ces_gate_plan_list" model="ir.ui.view">
        <field name="name">sgc.ces.gate.plan.list</field>
        <field name="model">sgc.ces.gate.plan</field>
        <field name="arch" type="xml">
            <list string="Gate Plans" decoration-muted="state in ('superseded','archived')">
                <field name="name"/>
                <field name="code"/>
                <field name="version"/>
                <field name="state" widget="badge"/>
                <field name="is_default"/>
                <field name="template_count"/>
                <field name="assignment_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_ces_gate_plan_form" model="ir.ui.view">
        <field name="name">sgc.ces.gate.plan.form</field>
        <field name="model">sgc.ces.gate.plan</field>
        <field name="arch" type="xml">
            <form string="Gate Plan">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_new_version" type="object" string="New Version"
                            invisible="state == 'draft'"/>
                    <button name="action_archive_plan" type="object" string="Archive"
                            invisible="state == 'archived'"/>
                    <button name="%(action_sgc_ces_preview_wizard)d" type="action"
                            string="Preview Schedule"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,superseded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Plan name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="version"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="start_date_strategy"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="predecessor_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this plan is for..."/>
                    <notebook>
                        <page string="Gates">
                            <field name="template_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="offset_months"/>
                                    <field name="duration_months"/>
                                    <field name="anchor"/>
                                    <field name="due_day_policy"/>
                                    <field name="working_day_adjustment"/>
                                    <field name="review_lead_days"/>
                                    <field name="outcome_policy"/>
                                    <field name="requirement_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Assignments">
                            <field name="assignment_ids" context="{'default_plan_id': id}">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="state"/>
                                    <field name="start_date"/>
                                    <field name="ces_start_date"/>
                                    <field name="manager_user_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sgc_ces_gate_plan" model="ir.actions.act_window">
        <field name="name">Gate Plans</field>
        <field name="res_model">sgc.ces.gate.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a gate plan</p>
            <p>A plan groups the gates a Customer Engagement Specialist must clear.
               Plans are versioned: once a plan is active and assigned, its rules freeze.</p>
        </field>
    </record>
</odoo>
