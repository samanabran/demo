<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgc_ces_baseline_assessment_list" model="ir.ui.view">
        <field name="name">sgc.ces.baseline.assessment.list</field>
        <field name="model">sgc.ces.baseline.assessment</field>
        <field name="arch" type="xml">
            <list string="Baseline Assessments" default_order="ces_start_date asc">
                <field name="employee_id"/>
                <field name="ces_start_date"/>
                <field name="tenure_month_at_assessment"/>
                <field name="suggested_gate_template_id"/>
                <field name="assigned_gate_template_id"/>
                <field name="assessment_due_date"/>
                <field name="manager_user_id"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'data_correction_required'"
                       decoration-warning="state in ('pending','in_review')"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_ces_baseline_assessment_form" model="ir.ui.view">
        <field name="name">sgc.ces.baseline.assessment.form</field>
        <field name="model">sgc.ces.baseline.assessment</field>
        <field name="arch" type="xml">
            <form string="Baseline Assessment">
                <header>
                    <button name="action_refresh_measurements" type="object"
                            string="Refresh Measurements" invisible="state in ('completed','canceled')"/>
                    <button name="action_apply_decision_and_activate" type="object"
                            string="Apply Decision and Activate" class="btn-primary"
                            invisible="state in ('completed','canceled') or not decision"/>
                    <button name="action_apply_decision" type="object" string="Apply Decision Only"
                            invisible="state in ('completed','canceled') or not decision"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed','canceled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,in_review,assigned,completed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Who">
                            <field name="employee_id" readonly="1"/>
                            <field name="manager_user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Tenure">
                            <field name="ces_start_date" readonly="1"/>
                            <field name="start_date_source" readonly="1"/>
                            <field name="tenure_month_at_assessment" readonly="1"/>
                            <field name="assessment_date"/>
                            <field name="assessment_due_date"/>
                        </group>
                    </group>
                    <group string="Gate">
                        <group>
                            <field name="suggested_gate_template_id" readonly="1"/>
                            <field name="assigned_gate_template_id"/>
                        </group>
                        <group>
                            <field name="decision"/>
                        </group>
                    </group>
                    <group string="Measurement snapshot (30 / 60 / 90 days)">
                        <group>
                            <field name="current_pipeline" readonly="1"/>
                            <field name="stale_pipeline" readonly="1"/>
                        </group>
                        <group>
                            <field name="signed_proposals_30d" readonly="1"/>
                            <field name="signed_proposals_60d" readonly="1"/>
                            <field name="signed_proposals_90d" readonly="1"/>
                        </group>
                        <group>
                            <field name="paid_deals_30d" readonly="1"/>
                            <field name="paid_deals_60d" readonly="1"/>
                            <field name="paid_deals_90d" readonly="1"/>
                        </group>
                    </group>
                    <field name="manager_notes" placeholder="Confidential - not shown to the employee's banner"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sgc_ces_baseline_assessment" model="ir.actions.act_window">
        <field name="name">Baseline Assessments</field>
        <field name="res_model">sgc.ces.baseline.assessment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
