<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgc_ces_gate_template_list" model="ir.ui.view">
        <field name="name">sgc.ces.gate.template.list</field>
        <field name="model">sgc.ces.gate.template</field>
        <field name="arch" type="xml">
            <list string="Gate Templates">
                <field name="sequence" widget="handle"/>
                <field name="plan_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="offset_months"/>
                <field name="duration_months"/>
                <field name="review_lead_days"/>
                <field name="requirement_count"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_ces_gate_template_form" model="ir.ui.view">
        <field name="name">sgc.ces.gate.template.form</field>
        <field name="model">sgc.ces.gate.template</field>
        <field name="arch" type="xml">
            <form string="Gate Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Gate name"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="plan_id"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Schedule">
                            <field name="anchor"/>
                            <field name="offset_months"/>
                            <field name="duration_months"/>
                            <field name="due_day_policy"/>
                            <field name="working_day_adjustment"/>
                            <field name="review_lead_days"/>
                            <field name="grace_days"/>
                        </group>
                    </group>
                    <group string="Outcome">
                        <field name="outcome_policy"/>
                        <field name="pass_threshold"/>
                    </group>
                    <field name="description"/>
                    <notebook>
                        <page string="Requirements">
                            <field name="requirement_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="metric_code"/>
                                    <field name="comparator"/>
                                    <field name="target_value"/>
                                    <field name="measurement_window"/>
                                    <field name="level"/>
                                    <field name="weight"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sgc_ces_gate_template" model="ir.actions.act_window">
        <field name="name">Gate Templates</field>
        <field name="res_model">sgc.ces.gate.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
